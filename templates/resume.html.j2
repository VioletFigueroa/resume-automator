<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ basics.name }} - Resume</title>
    <style>
        @page { size: Letter; margin: 0.55in 0.62in 0.58in; @top-center { content: element(page-header); } }
        @page:first { @top-center { content: none; } }
        :root { --ink: #171717; --muted: #555; --rule: #777; }
        * { box-sizing: border-box; }
        body { font-family: Arial, sans-serif; font-size: 9.2pt; line-height: 1.2; color: var(--ink); margin: 0; }
        .page-header { position: running(page-header); font-size: 8.5pt; color: var(--muted); border-bottom: 0.5pt solid var(--rule); padding-bottom: 3pt; width: 100%; }
        .page-header strong { color: var(--ink); }
        .header { text-align: center; margin-bottom: 15pt; }
        h1 { font-family: Georgia, serif; font-size: 22pt; margin: 0 0 2pt; font-weight: bold; }
        .role-title { font-size: 11pt; font-weight: bold; margin-bottom: 5pt; }
        .contact-info { font-size: 8.8pt; line-height: 1.45; }
        a { color: var(--ink); text-decoration: none; }
        .section { margin-bottom: 6pt; }
        h2 { font-family: Georgia, serif; font-size: 10.5pt; text-transform: uppercase; letter-spacing: 0.4pt; border-bottom: 1pt solid var(--ink); margin: 8pt 0 3pt; padding-bottom: 1pt; }
        .entry { break-inside: avoid; margin-bottom: 4pt; }
        .entry-header { display: flex; justify-content: space-between; gap: 12pt; align-items: baseline; }
        .entry-title { font-weight: bold; }
        .entry-date { white-space: nowrap; color: var(--muted); }
        .entry-subtitle { color: var(--muted); font-style: italic; }
        ul { margin: 2pt 0 0; padding-left: 15pt; }
        li { margin-bottom: 1pt; }
        .skills-grid { display: grid; grid-template-columns: 1.15in 1fr; gap: 2pt 8pt; }
        .skill-category { font-weight: bold; }
        .credentials { columns: 2; }
        .credentials li { break-inside: avoid; }
    </style>
</head>
<body>
    <div class="page-header"><strong>{{ basics.name }}</strong> | {{ basics.phone }} | {{ basics.email }}</div>
    <header class="header">
        <h1>{{ basics.name }}</h1>
        <div class="role-title">{{ basics.label }}</div>
        {% if headline %}<div>{{ headline }}</div>{% endif %}
        <div class="contact-info">{{ basics.location }} | {{ basics.phone }} | <a href="mailto:{{ basics.email }}">{{ basics.email }}</a></div>
        <div class="contact-info"><a href="{{ basics.linkedin }}">LinkedIn: {{ basics.linkedin|replace('https://', '')|replace('http://', '')|trim('/') }}</a> | <a href="{{ basics.github }}">GitHub: {{ basics.github|replace('https://', '')|replace('http://', '')|trim('/') }}</a> | <a href="{{ basics.portfolio }}">Portfolio: {{ basics.portfolio|replace('https://', '')|replace('http://', '')|trim('/') }}</a></div>
    </header>
    {% if highlights %}<section class="section"><h2>Highlights of Qualifications</h2><ul>{% for highlight in highlights %}<li>{{ highlight|replace(' → ', ': ')|replace(' (3.66)', '')|resume_bullet }}</li>{% endfor %}</ul></section>{% endif %}
    <section class="section"><h2>Education</h2>{% for edu in education %}<div class="entry"><div class="entry-header"><div class="entry-title">{{ edu.program }} | {{ edu.institution }}</div><div class="entry-date">{{ edu.date }}</div></div>{% if edu.location %}<div class="entry-subtitle">{{ edu.location }}</div>{% endif %}{% if edu.bullets %}<ul>{% for bullet in edu.bullets %}<li>{{ bullet|resume_bullet }}</li>{% endfor %}</ul>{% endif %}</div>{% endfor %}</section>
    <section class="section"><h2>Technical Skills</h2><div class="skills-grid">{% for category, skill_list in skills.items() %}{% if skill_list is iterable and skill_list is not string %}<div class="skill-category">{{ category|replace('_', ' ')|title }}</div><div>{{ skill_list|join(', ') }}</div>{% endif %}{% endfor %}</div></section>
    {% if academic_projects %}<section class="section"><h2>Academic Experience</h2>{% for project in academic_projects %}<div class="entry"><div class="entry-header"><div class="entry-title">{% if project.url %}<a href="{{ project.url }}">{{ project.title }}</a>{% else %}{{ project.title }}{% endif %}</div><div class="entry-date">{{ project.context|replace('COURSEWORK — ', '') if project.context else project.date }}</div></div><ul>{% for bullet in project.bullets[:2] %}<li>{{ bullet|resume_bullet }}</li>{% endfor %}</ul></div>{% endfor %}</section>{% endif %}
    {% if personal_projects %}<section class="section"><h2>Personal Projects</h2>{% for project in personal_projects %}<div class="entry"><div class="entry-header"><div class="entry-title">{% if project.url %}<a href="{{ project.url }}">{{ project.title }}</a>{% else %}{{ project.title }}{% endif %}</div><div class="entry-date">{{ project.date or project.context }}</div></div><ul>{% for bullet in project.bullets[:2] %}<li>{{ bullet|resume_bullet }}</li>{% endfor %}</ul></div>{% endfor %}</section>{% endif %}
    <section class="section"><h2>Professional Experience</h2>{% for job in experience %}{% if job.company != 'VanLUG' %}<div class="entry"><div class="entry-header"><div class="entry-title">{{ job.role }} | {{ job.company }}</div><div class="entry-date">{{ job.date }}</div></div><div class="entry-subtitle">{{ job.location }}</div><ul>{% for bullet in job.bullets[:4] %}<li>{{ bullet|resume_bullet }}</li>{% endfor %}</ul></div>{% endif %}{% endfor %}</section>
    {% if volunteer_experience %}<section class="section"><h2>Volunteer Experience</h2>{% for volunteer in volunteer_experience %}<div class="entry"><div class="entry-header"><div class="entry-title">{{ volunteer.role }} | {{ volunteer.organization }}</div><div class="entry-date">{{ volunteer.start_date }}</div></div><ul>{% for bullet in volunteer.board_contributions[:3] %}<li>{{ bullet|resume_bullet }}</li>{% endfor %}</ul></div>{% endfor %}</section>{% endif %}
    <section class="section"><h2>Credentials</h2><ul class="credentials">{% for cert in certifications %}<li>{{ cert|resume_bullet }}</li>{% endfor %}</ul></section>
</body>
</html>
